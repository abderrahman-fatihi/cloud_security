        <mxCell id="prowler" value="Prowler&#xa;(posture scan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="60" width="130" height="60" as="geometry"/>
