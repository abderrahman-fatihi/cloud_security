        <mxCell id="splunk" value="Splunk Enterprise&#xa;(Docker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="210" width="160" height="80" as="geometry"/>
