        <mxCell id="det" value="7 SPL detections&#xa;(MITRE ATT&amp;CK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1030" y="120" width="130" height="60" as="geometry"/>
