        <mxCell id="script" value="refresh_logs.sh&#xa;(s3 sync + jq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="610" y="330" width="130" height="60" as="geometry"/>
