        </mxCell>
        <mxCell id="sg" value="Security group&#xa;(planted: SSH 0.0.0.0/0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="210" y="160" width="140" height="50" as="geometry"/>
